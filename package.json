{
  "name": "negentropy-ui",
  "version": "0.1.0",
  "description": "Negentropy UI — a SvelteKit component library generated via the Vercel ui-sdk.",
	"license": "MIT",
	"author": "Fractalmandala",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "registry": "node scripts/build-registry.mjs",
    "new": "node scripts/new-component.mjs",
    "validate": "node scripts/build-registry.mjs && node scripts/validate.mjs",
    "smoke": "node scripts/smoke.mjs",
    "proof": "pnpm registry && pnpm check && pnpm validate && pnpm build && pnpm smoke"
  },
  "dependencies": {
    "@ui-sdk/core": "0.1.0-beta.1",
    "@ui-sdk/svelte": "0.1.0-beta.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "devDependencies": {
    "@lucide/svelte": "^0.544.0",
    "@sveltejs/adapter-auto": "^6.1.0",
    "@sveltejs/kit": "^2.43.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^24.5.0",
    "svelte": "^5.39.0",
    "svelte-check": "^4.3.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}